---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TranslateLM',
  description = 'AI 领域优质文章翻译',
} = Astro.props;

const fullTitle = title === 'TranslateLM' ? title : `${title} — TranslateLM`;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0e2" />
    <title>{fullTitle}</title>
    <link rel="alternate" type="application/rss+xml" title="TranslateLM" href={`${baseUrl}rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${baseUrl}global.css`} />
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav" aria-label="Main">
        <a href={baseUrl} class="logo" aria-label="TranslateLM — home">
          <!-- two interweaving arcs: source text and translation crossing over -->
          <svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
            <path d="M7 11 C 17 11, 23 29, 33 29" class="mk-a"></path>
            <path d="M7 29 C 17 29, 23 11, 33 11" class="mk-b"></path>
          </svg>
          <span class="logo-text">Translate<span class="initial">LM</span></span>
        </a>
        <a href={`${baseUrl}rss.xml`} class="nav-rss" aria-label="RSS 订阅">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-body">
        <div class="container footer-grid">
          <div class="footer-about">
            <p class="footer-name">TranslateLM</p>
            <p class="footer-tagline">AI 领域优质文章翻译</p>
          </div>
          <nav aria-label="相关链接">
            <ul class="footer-links" role="list">
              <li>
                <a
                  href="https://github.com/wanggang316/skills/tree/main/article-translate"
                  target="_blank"
                  rel="noreferrer"
                >
                  article-translate<span aria-hidden="true"> ↗</span>
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <div class="container footer-meta">
          <p>© {year} TranslateLM · Powered by <a href="https://astro.build" rel="noopener">Astro</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
