---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { readingTimeMinutes } from '../utils/reading-time';

const allTranslations = await getCollection('translations');
const sorted = allTranslations.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout>
  <div class="container">
    <section class="blog-index">
      <header class="page-header">
        <p class="eyebrow">Translations</p>
        <h1 class="page-title">译作精选</h1>
        <p class="intro">AI 领域优质文章的中文翻译，附原文链接，便于对照阅读。</p>
      </header>

      {sorted.length === 0 ? (
        <p class="empty">
          暂无译文 —— 将 Markdown 文件放入 <code>src/content/translations/</code> 即可。
        </p>
      ) : (
        <div class="post-list">
          {sorted.map((entry) => (
            <article class="post-card">
              <p class="meta">
                <time datetime={entry.data.date.toISOString()}>
                  {formatDate(entry.data.date)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{readingTimeMinutes(entry.body ?? '')} 分钟阅读</span>
                {entry.data.originalUrl && (
                  <a
                    href={entry.data.originalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-original"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    原文
                  </a>
                )}
              </p>
              {entry.data.source && (
                <p class="badges">
                  <span class="badge">{entry.data.source}</span>
                </p>
              )}
              <h2 class="title">
                <a href={`${baseUrl}translations/${entry.id}/`}>{entry.data.title}</a>
              </h2>
              {entry.data.originalTitle && (
                <p class="description">{entry.data.originalTitle}</p>
              )}
              {entry.data.tags.length > 0 && (
                <ul class="tags" role="list">
                  {entry.data.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
